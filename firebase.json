{
  "hosting": {
    "site": "csitba",
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/hackitba",
        "destination": "https://hackitba.web.app/",
        "type": 301
      },
      {
        "source": "/hackitba/**",
        "destination": "https://hackitba.web.app/:splat",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/admin/**",
        "function": {
          "functionId": "csitbaAdminApi",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [ 
      {
        "source": "**/*.@(jpg|jpeg|gif|png|js|css)",
        "headers": [ {
          "key": "Cache-Control",
          "value": "max-age=31536000"
        } ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "csitba",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
